# syntax=docker/dockerfile:1
# Web dashboard (@frontdesk/web): pnpm build -> nginx estático com proxy
# /v1 -> core-api. Contexto: raiz do repositório (workspace pnpm).
# Build: docker build -f infra/docker/Dockerfile.web .

FROM node:22-alpine AS build

# corepack picks the pnpm version pinned in package.json#packageManager.
RUN corepack enable

WORKDIR /repo

# Workspace manifests first so the install layer caches across code changes.
# apps/mobile/package.json is required: pnpm maps every lockfile importer.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY apps/mobile/package.json apps/mobile/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter "@frontdesk/web..."

# Source of the web app and its workspace dependency only.
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN pnpm --filter "@frontdesk/web" build

FROM nginx:1.27-alpine

# SPA + reverse proxy /v1 -> core-api (service name on the compose network).
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html

EXPOSE 80
