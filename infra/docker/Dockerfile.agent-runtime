# syntax=docker/dockerfile:1
# agent-runtime (Python 3.12 + uv, EPIC-003). Contexto: raiz do repositório.
# Build: docker build -f infra/docker/Dockerfile.agent-runtime .

FROM python:3.12-slim AS build

# uv binary straight from the official distroless image (pinned major).
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /uvx /bin/

ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependency layer first (cache): lockfile-driven, reproducible (--frozen).
COPY python/agent-runtime/pyproject.toml python/agent-runtime/uv.lock \
     python/agent-runtime/README.md ./
RUN uv sync --frozen --no-dev --no-install-project

# Project source, then install the project itself into the venv.
COPY python/agent-runtime/src ./src
RUN uv sync --frozen --no-dev

FROM python:3.12-slim

# Non-root runtime user (fixed uid for volume/K8s friendliness).
RUN useradd --create-home --uid 10001 --user-group agent

WORKDIR /app
COPY --from=build --chown=agent:agent /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

USER agent

EXPOSE 8091

# bridge.WebsocketGatewayServer is still a sketch (serve_forever raises
# NotImplementedError by design — tests drive Bridge directly). Until the
# websocket wiring lands, the container validates the import graph and idles,
# so compose topology, env and healthchecks are already exercised end-to-end.
CMD ["python", "-c", "import time, agent_runtime.bridge; print('agent-runtime up (WebsocketGatewayServer wiring pending, EPIC-003)', flush=True); time.sleep(float('inf'))"]
